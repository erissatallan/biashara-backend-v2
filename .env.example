# Biashara Agent environment variables
# Copy this file to .env and fill in the values.

# Base URL of the Biashara backend API (Node.js + SQLite).
# Use the public URL the Lua agent can reach (e.g. your server or an ngrok tunnel).
BACKEND_API_URL=http://localhost:4000

# Shared secret between the Lua tools and the backend (x-api-secret header).
# Pick any random string — must match what the backend is started with.
BACKEND_API_SECRET=dev-secret

# Lua user ID of the business owner (their WhatsApp → Lua user).
# Get this from admin.heylua.ai → Activity → the WhatsApp conversation.
# Leave blank until you have it, then redeploy.
OWNER_USER_ID=

# Credit check interval in hours (for demo purposes, can be set to 1 for faster testing)
CREDIT_CHECK_INTERVAL_HOURS=6

# Optional SMTP delivery for proposal PDFs.
# The backend will email the latest proposal to BUSINESS_OWNER_EMAIL when configured.
BUSINESS_OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
