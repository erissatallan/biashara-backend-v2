# Biashara Agent environment variables
# Configuration for local development

# Backend API running on localhost
BACKEND_API_URL=http://localhost:4000

# Shared secret between Lua tools and backend
BACKEND_API_SECRET=dev-secret

# Lua user ID of the business owner (get from admin.heylua.ai → Activity)
# TODO: Update this after messaging the agent on WhatsApp
OWNER_USER_ID=aa4b1a47-d948-45d8-831b-111a0e9e0f96

# Credit check runs every 6 hours
CREDIT_CHECK_INTERVAL_HOURS=6

# Optional: Email delivery for proposals (not required for basic demo)
BUSINESS_OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
